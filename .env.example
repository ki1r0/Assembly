# Copy to .env, edit locally, then: set -a; source .env; set +a
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://your-openai-compatible-provider.example/v1
OPENAI_MODEL=your-provider-model-id
# Absolute path to legally obtained assets; see docs/ASSETS.md.
ASSEMBLY_ASSET_ROOT=/absolute/path/to/assembly-assets
ASSEMBLY_CAMERA_WIDTH=960
ASSEMBLY_CAMERA_HEIGHT=720
ISAAC_DOCKER_IMAGE=nvcr.io/nvidia/isaac-lab:2.3.0
